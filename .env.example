# Copy to .env and fill in. Read by scripts/slack_bot.py.

# Bot User OAuth Token (OAuth & Permissions) and an app-level token with
# connections:write (Basic Information > App-Level Tokens).
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Who may use the bot is hard-coded in scripts/slack_bot.py (PLAYERS).
