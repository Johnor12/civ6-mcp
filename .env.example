# Copy to .env and fill in. Read by scripts/slack_bot.py.

# Bot User OAuth Token (OAuth & Permissions) and an app-level token with
# connections:write (Basic Information > App-Level Tokens).
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Who may use the bot is hard-coded in scripts/slack_bot.py (PLAYERS).

# Channel for pings, takeover requests and results (#proj-diplomatic-relations).
# CIV_CHANNEL_ID=C09AZ6CR7QE

# Players needed to approve Claude playing a late turn (the turn's owner alone is
# always enough). 1 lets any single player start it, as before approvals existed.
# APPROVALS_NEEDED=3

